#!/bin/bash
# RPM Repository Metrics Exporter for Prometheus
# Generated by Ansible - DO NOT EDIT MANUALLY

STATUS_FILE="{{ repo_base_path }}/rpm/status.json"
METRIC_FILE="/var/lib/node_exporter/textfile_collector/rpm.prom"

# Ensure directory exists
mkdir -p /var/lib/node_exporter/textfile_collector

# Extract status from JSON
if [ -f "$STATUS_FILE" ]; then
    STATUS=$(jq -r '.status' "$STATUS_FILE" 2>/dev/null || echo "unknown")
    LAST_RUN=$(jq -r '.last_run' "$STATUS_FILE" 2>/dev/null || echo "")

    # Convert status to numeric (1 = ok, 0 = failed/other)
    if [ "$STATUS" == "ok" ]; then
        STATUS_VAL=1
    else
        STATUS_VAL=0
    fi

    # Calculate age in seconds
    if [ -n "$LAST_RUN" ]; then
        LAST_RUN_EPOCH=$(date -d "$LAST_RUN" +%s 2>/dev/null || echo 0)
        NOW=$(date +%s)
        AGE=$((NOW - LAST_RUN_EPOCH))
    else
        AGE=0
    fi
else
    STATUS_VAL=0
    AGE=0
fi

# Write Prometheus metrics
cat <<EOF > "$METRIC_FILE"
# HELP rpm_sync_success Whether the last RPM sync was successful (1=success, 0=failed)
# TYPE rpm_sync_success gauge
rpm_sync_success $STATUS_VAL

# HELP rpm_sync_age_seconds Time since last successful RPM sync in seconds
# TYPE rpm_sync_age_seconds gauge
rpm_sync_age_seconds $AGE

# HELP rpm_sync_last_run_timestamp Unix timestamp of last RPM sync
# TYPE rpm_sync_last_run_timestamp gauge
rpm_sync_last_run_timestamp ${LAST_RUN_EPOCH:-0}
EOF

chmod 644 "$METRIC_FILE"
