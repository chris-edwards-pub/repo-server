#!/bin/bash
# RPM Repository Sync Script
# Generated by Ansible - DO NOT EDIT MANUALLY

set -euo pipefail

DATE=$(date +%Y-%m-%d)
LOG="{{ repo_base_path }}/logs/rpm-sync.log"
REPO_BASE="{{ repo_base_path }}/rpm"
LOCK_FILE="/var/run/rpm-sync.lock"
STATUS_FILE="{{ repo_base_path }}/rpm/status.json"

# Color output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

log() {
    echo "[$(date +'%Y-%m-%d %H:%M:%S')] $1" | tee -a "$LOG"
}

error() {
    echo -e "${RED}[ERROR]${NC} $1" | tee -a "$LOG"
}

success() {
    echo -e "${GREEN}[SUCCESS]${NC} $1" | tee -a "$LOG"
}

warn() {
    echo -e "${YELLOW}[WARNING]${NC} $1" | tee -a "$LOG"
}

# Prevent concurrent runs
if [ -f "$LOCK_FILE" ]; then
    error "Sync already running (lock file exists: $LOCK_FILE)"
    exit 1
fi
touch "$LOCK_FILE"
trap "rm -f $LOCK_FILE" EXIT

log "==== START RPM SYNC $DATE ===="

# Function to sync a repository for a specific architecture
sync_repo() {
    local repoid=$1
    local path=$2
    local arch=$3
    local description=$4

    log "Syncing $description ($repoid) for $arch..."

    if dnf reposync \
        --repoid="$repoid" \
        --download-metadata \
        --download-path="$path" \
        --arch="$arch" \
        --newest-only \
{% if rpm_download_rate is defined %}
        --downloadrate={{ rpm_download_rate }}M \
{% endif %}
        --norepopath \
        >> "$LOG" 2>&1; then
        success "$description ($arch) synced successfully"

        # Generate/update repository metadata
        local arch_dir="$path/$arch"
        if [ -d "$arch_dir" ] && [ -n "$(ls -A $arch_dir 2>/dev/null)" ]; then
            log "Generating metadata for $description ($arch)..."
            if createrepo_c --update "$arch_dir" >> "$LOG" 2>&1; then
                success "Metadata generated for $description ($arch)"
            else
                warn "Failed to generate metadata for $description ($arch)"
            fi
        fi
    else
        error "Failed to sync $description ($arch)"
        return 1
    fi
}

# Architectures to sync
ARCHITECTURES=({{ repo_rpm_architectures | join(' ') }})

# Sync Rocky Linux repositories for each architecture
for arch in "${ARCHITECTURES[@]}"; do
    sync_repo "baseos" \
        "$REPO_BASE/rocky/{{ repo_rocky_version }}/BaseOS" \
        "$arch" \
        "Rocky Linux {{ repo_rocky_version }} BaseOS"

    sync_repo "appstream" \
        "$REPO_BASE/rocky/{{ repo_rocky_version }}/AppStream" \
        "$arch" \
        "Rocky Linux {{ repo_rocky_version }} AppStream"

    sync_repo "extras" \
        "$REPO_BASE/rocky/{{ repo_rocky_version }}/extras" \
        "$arch" \
        "Rocky Linux {{ repo_rocky_version }} Extras"

    sync_repo "epel" \
        "$REPO_BASE/epel/{{ repo_epel_version }}" \
        "$arch" \
        "EPEL {{ repo_epel_version }}"
done

# Generate status file
if [ $? -eq 0 ]; then
    cat <<EOF > "$STATUS_FILE"
{
  "status": "ok",
  "last_run": "$(date -Iseconds)",
  "type": "rpm",
  "rocky_version": "{{ repo_rocky_version }}",
  "epel_version": "{{ repo_epel_version }}"
}
EOF
    success "RPM sync completed successfully"
    EXIT_CODE=0
else
    cat <<EOF > "$STATUS_FILE"
{
  "status": "failed",
  "last_run": "$(date -Iseconds)",
  "type": "rpm",
  "rocky_version": "{{ repo_rocky_version }}",
  "epel_version": "{{ repo_epel_version }}"
}
EOF
    error "RPM sync completed with errors"
    EXIT_CODE=1
fi

log "==== END RPM SYNC $DATE ===="

exit $EXIT_CODE
