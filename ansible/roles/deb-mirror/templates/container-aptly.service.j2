# Aptly Container Systemd Service
# Generated by Ansible - DO NOT EDIT MANUALLY

[Unit]
Description=Aptly Repository Mirror Container
Documentation=https://www.aptly.info/
Wants=network-online.target
After=network-online.target
RequiresMountsFor={{ repo_base_path }}/aptly

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
{% if proxy_http is defined %}
Environment=HTTP_PROXY={{ proxy_http }}
Environment=http_proxy={{ proxy_http }}
{% elif lookup('env', 'HTTP_PROXY') %}
Environment=HTTP_PROXY={{ lookup('env', 'HTTP_PROXY') }}
Environment=http_proxy={{ lookup('env', 'HTTP_PROXY') }}
{% endif %}
{% if proxy_https is defined %}
Environment=HTTPS_PROXY={{ proxy_https }}
Environment=https_proxy={{ proxy_https }}
{% elif lookup('env', 'HTTPS_PROXY') %}
Environment=HTTPS_PROXY={{ lookup('env', 'HTTPS_PROXY') }}
Environment=https_proxy={{ lookup('env', 'HTTPS_PROXY') }}
{% endif %}
{% if proxy_no is defined %}
Environment=NO_PROXY={{ proxy_no }}
Environment=no_proxy={{ proxy_no }}
{% elif lookup('env', 'NO_PROXY') %}
Environment=NO_PROXY={{ lookup('env', 'NO_PROXY') }}
Environment=no_proxy={{ lookup('env', 'NO_PROXY') }}
{% endif %}
Restart=on-failure
RestartSec=30
TimeoutStartSec=600
TimeoutStopSec=70

# Remove any existing container before starting
ExecStartPre=/usr/bin/podman rm -f aptly 2>/dev/null || true

# Create and start the container
ExecStart=/usr/bin/podman run \
    --rm \
    --name=aptly \
    --sdnotify=conmon \
    -v {{ repo_base_path }}/aptly/data:/aptly:Z \
    -v {{ repo_base_path }}/aptly/config:/root/.aptly:Z \
    -v {{ repo_base_path }}/aptly/public:/aptly/public:Z \
    -p 127.0.0.1:8080:8080 \
    --security-opt no-new-privileges \
    --cap-drop ALL \
    --cap-add NET_BIND_SERVICE \
    localhost/aptly:latest

# Stop the container gracefully
ExecStop=/usr/bin/podman stop -t 60 aptly

# Cleanup on stop
ExecStopPost=/usr/bin/podman rm -f aptly 2>/dev/null || true

# Resource limits
MemoryMax=4G
CPUQuota=75%

[Install]
WantedBy=multi-user.target
