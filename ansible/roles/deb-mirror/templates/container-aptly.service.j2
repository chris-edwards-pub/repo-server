# Aptly Container Systemd Service
# Generated by Ansible - DO NOT EDIT MANUALLY

[Unit]
Description=Aptly Repository Mirror Container
Documentation=https://www.aptly.info/
Wants=network-online.target
After=network-online.target
RequiresMountsFor={{ repo_base_path }}/aptly

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
Restart=on-failure
RestartSec=30
TimeoutStartSec=600
TimeoutStopSec=70

# Remove any existing container before starting
ExecStartPre=/usr/bin/podman rm -f aptly 2>/dev/null || true

# Pull image if missing (handles edge case where image was deleted)
ExecStartPre=/usr/bin/podman pull --quiet docker.io/aptly/aptly:latest

# Create and start the container
ExecStart=/usr/bin/podman run \
    --rm \
    --name=aptly \
    --sdnotify=conmon \
    -v {{ repo_base_path }}/aptly/data:/aptly:Z \
    -v {{ repo_base_path }}/aptly/config:/root/.aptly:Z \
    -v {{ repo_base_path }}/aptly/public:/aptly/public:Z \
    -p 127.0.0.1:8080:8080 \
    --security-opt no-new-privileges \
    --cap-drop ALL \
    --cap-add NET_BIND_SERVICE \
    docker.io/aptly/aptly:latest \
    aptly serve -listen=:8080

# Stop the container gracefully
ExecStop=/usr/bin/podman stop -t 60 aptly

# Cleanup on stop
ExecStopPost=/usr/bin/podman rm -f aptly 2>/dev/null || true

# Resource limits
MemoryMax=4G
CPUQuota=75%

[Install]
WantedBy=multi-user.target
