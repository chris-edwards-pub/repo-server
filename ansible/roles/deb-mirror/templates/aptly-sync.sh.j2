#!/bin/bash
# Aptly (DEB) Repository Sync Script
# Generated by Ansible - DO NOT EDIT MANUALLY

set -euo pipefail

DATE=$(date +%Y-%m-%d)
LOG="{{ repo_base_path }}/logs/aptly-sync.log"
STATUS_FILE="{{ repo_base_path }}/aptly/status.json"

# Color output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

log() {
    echo "[$(date +'%Y-%m-%d %H:%M:%S')] $1" | tee -a "$LOG"
}

error() {
    echo -e "${RED}[ERROR]${NC} $1" | tee -a "$LOG"
}

success() {
    echo -e "${GREEN}[SUCCESS]${NC} $1" | tee -a "$LOG"
}

warn() {
    echo -e "${YELLOW}[WARNING]${NC} $1" | tee -a "$LOG"
}

log "==== START APTLY SYNC $DATE ===="

# Check if mirrors exist, if not create them
check_and_create_mirrors() {
{% for mirror in deb_mirrors %}
    log "Checking mirror: {{ mirror.name }}"
    if ! podman exec aptly aptly mirror show {{ mirror.name }} &>/dev/null; then
        log "Creating mirror: {{ mirror.name }}"
{% if mirror.gpg_url is defined %}
        # Import GPG key if specified
        podman exec aptly bash -c "curl -fsSL {{ mirror.gpg_url }} | gpg --dearmor > /tmp/{{ mirror.name }}.gpg && gpg --import /tmp/{{ mirror.name }}.gpg" || warn "Failed to import GPG key for {{ mirror.name }}"
{% endif %}
        podman exec aptly aptly mirror create \
            -architectures={{ mirror.architectures | default(repo_deb_architectures) | join(',') }} \
            {{ mirror.name }} \
            {{ mirror.url }} \
            {{ mirror.distribution }} \
{% if mirror.components %}
            {{ mirror.components }} \
{% endif %}
            >> "$LOG" 2>&1 || error "Failed to create mirror {{ mirror.name }}"
    fi
{% endfor %}
}

# Update all mirrors
update_mirrors() {
{% for mirror in deb_mirrors %}
    log "Updating mirror: {{ mirror.name }}"
    if podman exec aptly aptly mirror update {{ mirror.name }} >> "$LOG" 2>&1; then
        success "Mirror {{ mirror.name }} updated successfully"
    else
        error "Failed to update mirror {{ mirror.name }}"
        return 1
    fi
{% endfor %}
}

# Create snapshots
create_snapshots() {
{% for mirror in deb_mirrors %}
    log "Creating snapshot for {{ mirror.name }}"
    podman exec aptly aptly snapshot create {{ mirror.name }}-$DATE from mirror {{ mirror.name }} >> "$LOG" 2>&1 || warn "Failed to create snapshot for {{ mirror.name }}"
{% endfor %}
}

# Merge Ubuntu base snapshots (amd64 + arm64)
merge_ubuntu_snapshots() {
    log "Merging Ubuntu base snapshots (amd64 + arm64)"
    podman exec aptly aptly snapshot merge ubuntu-full-$DATE \
        ubuntu-noble-amd64-$DATE \
        ubuntu-noble-arm64-$DATE \
        ubuntu-noble-updates-amd64-$DATE \
        ubuntu-noble-updates-arm64-$DATE \
        ubuntu-noble-security-amd64-$DATE \
        ubuntu-noble-security-arm64-$DATE \
        >> "$LOG" 2>&1 || warn "Failed to merge Ubuntu snapshots"
}

# Publish snapshots
publish_snapshots() {
    log "Publishing merged Ubuntu snapshot"

    # Check if already published
    if podman exec aptly aptly publish show {{ repo_ubuntu_release }} &>/dev/null; then
        log "Publication exists, switching to new snapshot"
        podman exec aptly aptly publish switch \
            {{ repo_ubuntu_release }} \
            ubuntu-full-$DATE \
            >> "$LOG" 2>&1 || error "Failed to switch publication"
    else
        log "Creating new publication"
        podman exec aptly aptly publish snapshot \
            -distribution={{ repo_ubuntu_release }} \
            -architectures="{{ repo_deb_architectures | join(',') }}" \
            -gpg-key="{{ aptly_gpg_key_name }}" \
            ubuntu-full-$DATE \
            >> "$LOG" 2>&1 || error "Failed to publish snapshot"
    fi
}

# Cleanup old snapshots (keep last 7 days)
cleanup_old_snapshots() {
    log "Cleaning up old snapshots"
    podman exec aptly aptly snapshot list | \
        grep -E 'ubuntu-.*-[0-9]{4}-[0-9]{2}-[0-9]{2}' | \
        head -n -7 | \
        awk '{print $2}' | \
        xargs -r -I {} podman exec aptly aptly snapshot drop {} \
        >> "$LOG" 2>&1 || warn "Cleanup encountered errors"
}

# Main execution
SYNC_ERROR=0

check_and_create_mirrors || SYNC_ERROR=1
update_mirrors || SYNC_ERROR=1
create_snapshots || SYNC_ERROR=1
merge_ubuntu_snapshots || SYNC_ERROR=1
publish_snapshots || SYNC_ERROR=1
cleanup_old_snapshots || SYNC_ERROR=1

# Generate status file
if [ $SYNC_ERROR -eq 0 ]; then
    cat <<EOF > "$STATUS_FILE"
{
  "status": "ok",
  "last_run": "$(date -Iseconds)",
  "type": "deb",
  "ubuntu_release": "{{ repo_ubuntu_release }}",
  "mirror_count": {{ deb_mirrors | length }}
}
EOF
    success "Aptly sync completed successfully"
else
    cat <<EOF > "$STATUS_FILE"
{
  "status": "failed",
  "last_run": "$(date -Iseconds)",
  "type": "deb",
  "ubuntu_release": "{{ repo_ubuntu_release }}",
  "mirror_count": {{ deb_mirrors | length }}
}
EOF
    error "Aptly sync completed with errors"
fi

log "==== END APTLY SYNC $DATE ===="

exit $SYNC_ERROR
