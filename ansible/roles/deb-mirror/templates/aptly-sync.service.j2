[Unit]
Description=Aptly Mirror Sync and Snapshot
Wants=network-online.target container-aptly.service
After=network-online.target container-aptly.service
Documentation=https://github.com/your-org/repo-server

[Service]
Type=oneshot
ExecStart=/usr/local/bin/aptly-sync.sh
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7

# Resource limits
MemoryMax=4G
CPUQuota=75%

# Hardening
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
# NoNewPrivileges disabled - conflicts with podman exec SELinux transitions
ReadOnlyPaths=/etc
ReadWritePaths={{ repo_base_path }}

# Logging
StandardOutput=append:{{ repo_base_path }}/logs/aptly-sync.log
StandardError=append:{{ repo_base_path }}/logs/aptly-sync.log
SyslogIdentifier=aptly-sync

# Restart policy
Restart=on-failure
RestartSec=300

[Install]
WantedBy=multi-user.target
