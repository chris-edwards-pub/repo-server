# Repository Mirror NGINX Configuration
# Generated by Ansible - DO NOT EDIT MANUALLY

# Upstream for Aptly container
upstream aptly_backend {
    server 127.0.0.1:{{ aptly_port | default(8080) }};
    keepalive 32;
}

server {
    listen 80;
    server_name {{ repo_server_hostname }};

    # Root directory for static repos
    root {{ repo_base_path }};

    # Enable directory listing
    autoindex on;
    autoindex_exact_size off;
    autoindex_localtime on;

    # Logging
    access_log /var/log/nginx/repo-mirror-access.log;
    error_log /var/log/nginx/repo-mirror-error.log;

    # Global compression settings
{% if nginx_enable_gzip | default(true) %}
    gzip on;
    gzip_vary on;
    gzip_types text/plain text/xml application/xml application/x-rpm
               application/x-debian-package application/x-gzip application/json;
    gzip_comp_level 6;
    gzip_min_length 1024;
{% endif %}

    # Increase buffer sizes for large repository metadata
    client_body_buffer_size 128k;
    client_max_body_size 512M;

    # ===================================================================
    # RPM REPOSITORIES (served directly from filesystem)
    # ===================================================================
    location /rpm/ {
        alias {{ repo_base_path }}/rpm/;
        autoindex on;

        # Cache RPM packages aggressively (they're immutable)
        location ~* \.rpm$ {
            add_header Cache-Control "public, max-age=31536000, immutable";
            add_header X-Content-Type-Options "nosniff";
        }

        # Don't cache repository metadata (needs to be fresh)
        location ~* (repomd\.xml|primary\.xml|filelists\.xml|other\.xml|.*\.gz|.*\.xz)$ {
            add_header Cache-Control "no-cache, must-revalidate";
            add_header X-Content-Type-Options "nosniff";
            expires -1;
        }
    }

    # ===================================================================
    # DEB REPOSITORIES (proxied to Aptly container)
    # ===================================================================
    location /deb/ {
        proxy_pass http://aptly_backend/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Increase timeouts for large package downloads
        proxy_connect_timeout 300s;
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;
        proxy_buffering on;
        proxy_buffer_size 128k;
        proxy_buffers 4 256k;
        proxy_busy_buffers_size 256k;

        # Don't cache Packages/Release files (metadata)
        location ~* (Packages|Release|InRelease)$ {
            proxy_pass http://aptly_backend;
            add_header Cache-Control "no-cache, must-revalidate";
            add_header X-Content-Type-Options "nosniff";
            expires -1;
        }

        # Cache .deb files aggressively (immutable)
        location ~* \.deb$ {
            proxy_pass http://aptly_backend;
            add_header Cache-Control "public, max-age=31536000, immutable";
            add_header X-Content-Type-Options "nosniff";
        }
    }

    # ===================================================================
    # GPG PUBLIC KEY
    # ===================================================================
    location /public.key {
        alias {{ repo_base_path }}/aptly/public/public.key;
        add_header Content-Type "application/pgp-keys";
    }

    # ===================================================================
    # MONITORING ENDPOINTS
    # ===================================================================
    location /health {
        return 200 '{"status":"ok","service":"repo-mirror","timestamp":"$time_iso8601"}';
        add_header Content-Type application/json;
        access_log off;
    }

    location /status/rpm {
        alias {{ repo_base_path }}/rpm/status.json;
        add_header Content-Type application/json;
        add_header Cache-Control "no-cache";
    }

    location /status/deb {
        alias {{ repo_base_path }}/aptly/status.json;
        add_header Content-Type application/json;
        add_header Cache-Control "no-cache";
    }

    # ===================================================================
    # NGINX METRICS (for Prometheus nginx exporter)
    # ===================================================================
    location /nginx_status {
        stub_status on;
        access_log off;
        allow 127.0.0.1;
        allow 10.0.0.0/8;
        allow 172.16.0.0/12;
        allow 192.168.0.0/16;
        deny all;
    }

    # ===================================================================
    # SECURITY HEADERS
    # ===================================================================
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;

    # Deny access to hidden files
    location ~ /\. {
        deny all;
        access_log off;
        log_not_found off;
    }
}
